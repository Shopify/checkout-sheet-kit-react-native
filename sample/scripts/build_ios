#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/simulator"
CURRENT_SIMULATOR_UUID="${CURRENT_SIMULATOR_UUID:-}"
destination=""
configurations=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --configuration)
      if [ "$#" -lt 2 ] || { [ "$2" != Debug ] && [ "$2" != Release ]; }; then
        echo "--configuration needs Debug or Release." >&2
        exit 1
      fi
      configurations+=("$2")
      shift 2
      ;;
    --destination)
      if [ "$#" -lt 2 ] || [ -z "$2" ]; then
        echo "--destination needs an Xcode destination." >&2
        exit 1
      fi
      destination="$2"
      shift 2
      ;;
    *)
      echo "Usage: build_ios [--configuration Debug|Release] [--destination DESTINATION]" >&2
      exit 1
      ;;
  esac
done

if [ "${#configurations[@]}" -eq 0 ]; then
  configurations=(Debug Release)
fi
if [ -z "$destination" ]; then
  destination="$(get_sim_destination)"
fi

(cd "$SCRIPT_DIR/.." && pnpm spm)
cd "$SCRIPT_DIR/../ios"

run_xcodebuild() {
  xcodebuild build \
    -project ReactNative.xcodeproj \
    -scheme ReactNative \
    -configuration "$1" \
    -sdk iphonesimulator \
    -destination "$destination" \
    -derivedDataPath build/swiftpm \
    -disableAutomaticPackageResolution \
    -onlyUsePackageVersionsFromResolvedFile \
    CODE_SIGNING_ALLOWED=NO \
    COMPILER_INDEX_STORE_ENABLE=NO
}

for configuration in "${configurations[@]}"; do
  if command -v xcbeautify >/dev/null 2>&1; then
    run_xcodebuild "$configuration" | xcbeautify
  else
    run_xcodebuild "$configuration"
  fi
done
